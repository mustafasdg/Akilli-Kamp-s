{
  "expo": {
    "name": "ISUBÜ Akıllı Kampüs",
    "slug": "isubu-akilli-kampus",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "isubu",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/images/logo-icon.png",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tr.edu.isubu.akillikampus"
    },
    "android": {
      "package": "tr.edu.isubu.akillikampus",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-notifications"
    ]
  }
}
